{
  "name": "bottle-harmony",
  "version": "0.0.1",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:solver": "node --expose-gc --experimental-strip-types scripts/benchmark-solver.ts",
    "benchmark:production": "node --expose-gc --experimental-strip-types scripts/benchmark-production.ts",
    "levels:generate": "node --experimental-strip-types scripts/levels.ts generate",
    "levels:verify": "node --experimental-strip-types scripts/levels.ts verify",
    "levels:rate": "node --experimental-strip-types scripts/difficulty.ts",
    "art": "node --experimental-strip-types scripts/render-art.ts",
    "ios:device": "expo run:ios --device --configuration Release",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --max-workers=3 \"-Dorg.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=1g\"",
    "catalog:build": "node --experimental-strip-types scripts/catalog.ts build",
    "catalog:verify": "node --experimental-strip-types scripts/catalog.ts verify",
    "production:plan": "node --experimental-strip-types scripts/production.ts plan",
    "production:rate": "node --experimental-strip-types scripts/production.ts rate",
    "production:verify": "node --experimental-strip-types scripts/production.ts verify",
    "mainline:build": "node --experimental-strip-types scripts/mainline.ts build",
    "mainline:verify": "node --experimental-strip-types scripts/mainline.ts verify",
    "mainline:audit": "node --experimental-strip-types scripts/audit-mainline.ts",
    "mainline:human": "node --experimental-strip-types scripts/human-difficulty.ts",
    "side:build": "node --experimental-strip-types scripts/solid-structure-research.ts --assemble-side50",
    "side:verify": "node --experimental-strip-types --test tests/solidSide.test.ts",
    "mainline:candidates": "node --experimental-strip-types scripts/mainline-candidates.ts",
    "mainline:wave-candidates": "node --experimental-strip-types scripts/wave-candidates.ts",
    "mainline:replan": "node --experimental-strip-types scripts/replan-mainline.ts",
    "mainline:replace": "node --experimental-strip-types scripts/replace-mainline-score-matched.ts",
    "mainline:opening-mix": "node --experimental-strip-types scripts/refresh-opening-mix.ts",
    "mainline:features": "node --experimental-strip-types scripts/mainline-features.ts",
    "mainline:evaluate": "node --experimental-strip-types scripts/evaluate-mainline.ts",
    "mainline:reserves": "node --experimental-strip-types scripts/rebuild-optional-reserve.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
