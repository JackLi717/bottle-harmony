{
  "name": "bottle-harmony",
  "version": "0.0.1",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:solver": "node --expose-gc --experimental-strip-types scripts/benchmark-solver.ts",
    "levels:generate": "node --experimental-strip-types scripts/levels.ts generate",
    "levels:verify": "node --experimental-strip-types scripts/levels.ts verify",
    "art": "node --experimental-strip-types scripts/render-art.ts",
    "ios:device": "expo run:ios --device --configuration Release",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --max-workers=3 \"-Dorg.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=1g\""
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
